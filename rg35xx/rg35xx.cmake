# CMake toolchain for the RG35XX (Cortex-A9, armhf, PowerVR SGX544 / GLES2)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
set(TC /opt/rg35xx)
set(CMAKE_SYSROOT ${TC}/arm-buildroot-linux-gnueabihf/sysroot)
set(CMAKE_C_COMPILER ${TC}/bin/arm-buildroot-linux-gnueabihf-gcc)
set(CMAKE_CXX_COMPILER ${TC}/bin/arm-buildroot-linux-gnueabihf-g++)
set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(RG35XX_ARCH "-marm -mcpu=cortex-a9 -mfpu=neon-fp16 -mfloat-abi=hard")
set(CMAKE_C_FLAGS_INIT "${RG35XX_ARCH} -DRG35XX")
set(CMAKE_CXX_FLAGS_INIT "${RG35XX_ARCH} -DRG35XX")
